{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "words": [
    "Alves",
    "anonimização",
    "Anonymization",
    "antiforgery",
    "aplicacao",
    "appbar",
    "ASPNETCORE",
    "azuread",
    "azurerm",
    "buildar",
    "buildtransitive",
    "chdir",
    "clusterizada",
    "clusterizado",
    "contentfiles",
    "csdevkit",
    "dotnet",
    "dotnettools",
    "Eleken",
    "Fisco",
    "FiscoProjects",
    "focável",
    "Gantt",
    "gantt",
    "glossario",
    "gstatic",
    "healthcheck",
    "httponly",
    "instalacao",
    "integracao",
    "LGPD",
    "MADR",
    "Mapperly",
    "MediatR",
    "Mendes",
    "Menlo",
    "monolito",
    "nameof",
    "Nogueira",
    "nullable",
    "nvarchar",
    "oklab",
    "oklch",
    "openspec",
    "opsx",
    "persistencia",
    "pipefail",
    "Plex",
    "QUOTENAME",
    "recolhível",
    "rgba",
    "rseidelsohn",
    "Segoe",
    "slnx",
    "Souza",
    "subnúmero",
    "subtarefas",
    "Syncfusion",
    "techlead",
    "Testcontainers",
    "tfvars",
    "Tiptap",
    "topbar",
    "warnaserror",
    "wwwroot",
    "xunit"
  ],
  "ignorePaths": [
    "**/bin/**",
    "**/obj/**",
    "**/node_modules/**",
    ".claude/**",
    "docs/adr/**",
    "*.slnx",
    "global.json"
  ],
  "patterns": [
    {
      "name": "spec-scenario-name",
      "pattern": "/DisplayName = \"[^\"]*\"/g"
    },
    {
      "name": "spec-reference-comment",
      "pattern": "/^\\s*\\/\\/ (Spec:|and \").*$/gm"
    },
    {
      "name": "markdown-inline-code",
      "pattern": "/`[^`\\n]*`/g"
    },
    {
      "name": "markdown-code-block",
      "pattern": "/^\\s*```[\\s\\S]*?^\\s*```/gm"
    },
    {
      "name": "vitest-test-name",
      "pattern": "/\\b(?:describe|it|test)\\(\\s*'[^']*'/g"
    }
  ],
  "overrides": [
    {
      "filename": [
        "**/*.cs"
      ],
      "ignoreRegExpList": [
        "spec-scenario-name",
        "spec-reference-comment"
      ]
    },
    {
      "filename": [
        "web/src/**/*.test.ts",
        "web/src/**/*.test.tsx"
      ],
      "ignoreRegExpList": [
        "vitest-test-name",
        "spec-reference-comment"
      ]
    },
    {
      "filename": [
        "**/*.md",
        "openspec/**/*.yaml",
        "docs/**/*.html"
      ],
      "language": "pt-BR,en",
      "ignoreRegExpList": [
        "markdown-inline-code",
        "markdown-code-block"
      ]
    },
    {
      "filename": [
        "web/src/locales/**/*.json",
        "web/src/theme/tokens.json"
      ],
      "language": "pt-BR,en"
    }
  ]
}
