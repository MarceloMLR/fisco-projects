<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>fisco-projects-api</UserSecretsId>
  </PropertyGroup>

  <!-- The API contract the frontend types come from (ADR-0076), written to web/src/api/openapi.json.
       Generated only on request, by `npm run api:update` in web/; the tests flag a stale contract. -->
  <PropertyGroup>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../web/src/api</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FiscoProjects.Persistence/FiscoProjects.Persistence.csproj" />
    <ProjectReference Include="../FiscoProjects.SharedKernel/FiscoProjects.SharedKernel.csproj" />
  </ItemGroup>

</Project>
