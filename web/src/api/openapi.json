  },
  "components": {
    "schemas": {
      "AuditAction": {
        "enum": [
          "Created",
          "Updated",
          "Deleted",
          "SignedIn",
          "SignInRefused"
        ],
        "description": "What an audit record says happened."
      },
      "AuditActorResponse": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Who did it; null on the record means the system."
      },
      "AuditEntryResponse": {
        "required": [
          "id",
          "occurredAt",
          "actor",
          "action",
          "itemType",
          "itemId",
          "itemLabel",
          "detail",
          "changes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AuditActorResponse"
              }
            ]
          },
          "action": {
            "$ref": "#/components/schemas/AuditAction"
          },
          "itemType": {
            "type": "string"
          },
          "itemId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "itemLabel": {
            "type": [
              "null",
              "string"
            ]
          },
          "detail": {
            "type": [
              "null",
              "string"
            ],
            "description": "The identity provider of a sign-in, or why a sign-in was refused."
          },
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditFieldResponse"
            }
          }
        },
        "description": "One record of the Audit screen."
      },
      "AuditFieldResponse": {
        "required": [
          "field",
          "before",
          "after",
          "secret"
        ],
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "before": {
            "type": [
              "null",
              "string"
            ]
          },
          "after": {
            "type": [
              "null",
              "string"
            ]
          },
          "secret": {
            "type": "boolean"
          }
        },
        "description": "A changed field: the value before and after as invariant text, or none for a secret."
      },
      "AuditPageResponse": {
        "required": [
          "items",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntryResponse"
            }
          },
          "total": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ChangeRoleRequest": {
        "required": [
          "role"
        ],
        "type": "object",
        "properties": {
          "role": {
            "$ref": "#/components/schemas/SystemRole"
          }
        }
      },
      "ChooseThemeRequest": {
        "required": [
          "theme"
        ],
        "type": "object",
        "properties": {
          "theme": {
            "$ref": "#/components/schemas/ThemePreference"
          }
        }
      },
      "GeneralRulesResponse": {
        "required": [
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "timeZone": {
            "type": "string"
          }
        },
        "description": "The rules of the installation for the screens: the IANA time zone of dates and times (ADR-0013)."
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "InstallationResponse": {
        "required": [
          "name",
          "logoUrl",
          "mainColor"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "logoUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "mainColor": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "The brand of the installation: the name shown, the address of the logo (null without one) and the main color as\n#RRGGBB (null for the color of the design system). The address of the logo changes whenever the logo changes, so the\nbrowser may keep it."
      },
      "LocalSignInRequest": {
        "required": [
          "email"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProfileResponse": {
        "required": [
          "id",
          "name",
          "email",
          "role",
          "theme",
          "lastSignInAt",
          "signInMethods"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/SystemRole"
          },
          "theme": {
            "$ref": "#/components/schemas/ThemePreference"
          },
          "lastSignInAt": {
            "type": "string",
            "format": "date-time"
          },
          "signInMethods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "description": "My profile: who the person is, how they sign in and the theme they chose. Sign-in providers come as their codes\n(\"local\", and \"entra\" later); the screen says them in words."
      },
      "SessionUserResponse": {
        "required": [
          "id",
          "name",
          "email",
          "role",
          "theme"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/SystemRole"
          },
          "theme": {
            "$ref": "#/components/schemas/ThemePreference"
          }
        },
        "description": "The person in the session, with the role in the system and the theme of their screens."
      },
      "SignInOptionsResponse": {
